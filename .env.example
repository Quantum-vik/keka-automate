# Auto-Keka configuration — copy to your per-user data dir as `.env`:
#   macOS:   ~/Library/Application Support/Auto-Keka/.env
#   Linux:   ~/.local/share/Auto-Keka/.env   (or $XDG_DATA_HOME/Auto-Keka/.env)
#   Windows: %APPDATA%\Auto-Keka\.env
# The app's Settings sheet and setup.sh/setup.ps1 write this file for you —
# manual editing is only needed for headless/advanced setups.
# Keep it private (chmod 600); it is never uploaded anywhere.

# Your company's Keka portal and login credentials (required)
KEKA_BASE_URL=https://your-company.keka.com
KEKA_EMAIL=you@company.com
KEKA_PASSWORD=your-password

# Daily punch times, 24-hour HH:MM (the schedule installers read these)
KEKA_IN_TIME=09:00
KEKA_OUT_TIME=18:00

# Set to 1 once the first-run wizard completes (managed by the app)
#KEKA_ONBOARDED=1
